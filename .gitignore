# Corpora (plan §1.1): raw downloads and processed jsonl are never committed
data/raw/
data/processed/
data/processed_smoke/
data/embeddings/
# Loader previews hold full third-party texts; regenerated by the build, never committed
reports/figures/loader_check_*.html

# Pack artefacts: only schema.yaml (and pack config) are tracked
packs/*/prototypes/
packs/*/classifier/
packs/*/index/

# Runs: only the run log is tracked
runs/*
!runs/log.csv

# Checkpoints and caches
checkpoints/
*.ckpt
*.pt
*.safetensors
.cache/
wandb/

# Lab transfer bundle and session outputs
lab_bundle/
lab_out/

# Environment and secrets
.venv/
.env
.env.*

# Python / tooling
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.gradio/
.DS_Store
